# Leave OPENAI_API_KEY empty to run fully offline (local hashing embeddings + extractive answers).
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
FALLBACK_CHAT_MODEL=gpt-4.1-nano
# auto | openai | hashing  (auto = openai if a key is set)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# pgvector | memory
VECTOR_BACKEND=pgvector
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
COLLECTION_NAME=sales_docs

TOP_K=4
CACHE_TTL_SECONDS=600
LOG_LEVEL=INFO
LOG_JSON=true
